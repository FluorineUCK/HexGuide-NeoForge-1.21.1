{
  "schemaVersion": 1,
  "id": "hexguide",
  "version": "${version}",
  "name": "Hex Guide",
  "description": "Hex Guide addon for Hex Casting",
  "authors": [
    "xm1221"
  ],
  "contact": {
    "homepage": "https://xm1221.github.io/HexGuide",
    "sources": "https://github.com/xm1221/HexGuide"
  },
  "license": "MIT",
  "icon": "assets/hexguide/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexGuide.fabric.FabricHexGuide"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexGuide.fabric.FabricHexGuideClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexGuide.fabric.FabricHexGuideServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexGuide.fabric.datagen.FabricHexGuideDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexGuide.fabric.FabricHexGuideModMenu"
    }]
  },
  "mixins": [
    "hexguide-common.mixins.json",
    "hexguide-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
