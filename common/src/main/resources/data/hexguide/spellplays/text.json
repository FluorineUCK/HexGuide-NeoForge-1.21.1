{
  "title": "咒术MIe Demo",
  "interval": 50,
  "clear_before": true,
  "start_dir": "NORTH_EAST",
  "steps": [
    { "type": "execute", "action": "hexcasting:empty_list", "origin": [-1, 2], "pattern": "aa", "start_dir": "EAST" },
    { "type": "execute", "action": "hexcasting:get_caster", "interval": 80 },
    { "type": "push", "pattern": "aqw", "push": "double:3.14", "title": "压入数字" },
    { "type": "push", "pattern": "aqweds", "start_dir": "EAST", "origin": [0, -2], "push": "vec:{1,2,3}" },
    { "type": "push", "pattern": "aa", "push": "pattern:hexcasting:empty_list" },
    { "type": "push", "pattern": "qaq", "push": "pattern{NORTH_EAST,qqaeaae}" },
    { "type": "push", "pattern": "aa", "push": "null" },
    { "type": "peek", "index": 0, "pattern": "aq", "title": "弹出栈顶" },
    { "type": "peek", "indices": [0, 1], "pattern": "aa" },
    { "type": "clear", "interval": 30, "title": "清空画布" },
    { "type": "execute", "action": "hexcasting:get_caster", "color": "#ffd93d" }
  ]
}
