      hexguide_patterns: "HexGuide 图案",
      guide: {
        stack: "栈，咒术网格与施法环境",
        iotas: "Iotas",
        actions: "图案、操作与法术",
        spellcasting: "咒术网格",
        escape: "内省、考察与反思",
